# ======================
# BACKEND
# ======================
API_PORT=8000
API_PREFIX=api

# ======================
# DATABASE
# ======================
DB_HOST=postgres-prod
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123
DB_DATABASE=mini_inventory_db
